# ============================================================================
#  Latido — variables para PRODUCCIÓN (péguelas en Coolify → Environment).
#  NO subas este archivo con valores reales al repo. Coolify guarda los valores.
#
#  [COPIAR]  = usa el MISMO valor de tu .env local (no los cambies o rompes
#              el cifrado/login/acceso a MinIO si migras datos).
#  [CAMBIAR] = valor nuevo de producción.
# ============================================================================

# --- Dominio / red  [CAMBIAR] ---
PUBLIC_URL=https://tudominio.com            # dominio HTTPS del sitio (Coolify pone el SSL)
CORS_ORIGINS=https://tudominio.com

# --- Base de datos  [COPIAR o CAMBIAR si arrancas limpio] ---
DB_USER=latido_app
DB_PASSWORD=pon_una_password_fuerte
DB_NAME=latido

# --- Redis  [CAMBIAR: password fuerte] ---
REDIS_PASSWORD=pon_una_password_fuerte

# --- MinIO (S3)  [COPIAR de tu .env si migras datos; si no, define nuevas] ---
MINIO_ROOT_USER=latido_minio
MINIO_ROOT_PASSWORD=pon_una_password_fuerte
S3_REGION=us-east-1
S3_BUCKET_MEDIA=latido-media
S3_BUCKET_PUBLIC=latido-public
MEDIA_SIGNED_URL_TTL=45

# --- Seguridad  [COPIAR EXACTO de tu .env local] ---
# Si migras la BD, estos DEBEN ser los mismos o los datos cifrados/tokens se rompen.
DATA_ENCRYPTION_KEY=copia_los_64_hex_de_tu_.env
JWT_ACCESS_SECRET=copia_de_tu_.env
JWT_REFRESH_SECRET=copia_de_tu_.env
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
WATERMARK_SALT=copia_de_tu_.env
CONTENT_CONSENT_VERSION=1.0
LOGIN_MAX_FAILS=8
LOGIN_LOCK_SECONDS=900
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120
DIAMOND_COP=20

# --- LiveKit  [CAMBIAR url; secret COPIAR de tu .env] ---
LIVEKIT_URL=wss://tudominio.com:7880        # o un subdominio livekit.tudominio.com
LIVEKIT_API_KEY=latido_lk
LIVEKIT_API_SECRET=copia_de_tu_.env

# --- KYC ---
KYC_PROVIDER=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=
KYC_AUTO_APPROVE=true
KYC_FACE_MATCH_MIN=0.85

# --- Wompi  [CAMBIAR: llaves REALES de producción] ---
WOMPI_MODE=production
WOMPI_PUBLIC_KEY=pub_prod_xxx
WOMPI_PRIVATE_KEY=prv_prod_xxx
WOMPI_INTEGRITY_SECRET=xxx
WOMPI_EVENTS_SECRET=xxx
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
